# Copy to .env and edit. Placeholders only: never commit .env, and never
# put a real credential in this file. Every variable is optional in
# dev/test (random per-process secrets are generated with a warning);
# in prod ATLAS_TOKEN_SECRET and ATLAS_REDACTION_KEY are required.

ATLAS_ENV=dev                         # dev | test | prod
ATLAS_LOG_LEVEL=INFO

# Unset = in-memory store. Set to use PostgreSQL with pgvector.
# (Docker Compose sets its own value for the app container.)
# ATLAS_DATABASE_URL=postgresql://atlas:CHANGE_ME@localhost:5432/atlas

# Required in prod (at least 32 characters). Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ATLAS_TOKEN_SECRET=CHANGE_ME
# ATLAS_REDACTION_KEY=CHANGE_ME
ATLAS_REDACTION_KEY_VERSION=v1

# mock needs no key and costs nothing. anthropic or openai need the
# optional SDKs (requirements-providers.txt) and a key from your account.
ATLAS_MODEL_PROVIDER=mock
ATLAS_MODEL_PRIMARY=mock-large
ATLAS_MODEL_FALLBACK=mock-small
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

ATLAS_DAILY_COST_CAP_USD=50
ATLAS_EGRESS_ALLOWLIST=tickets.example.com
ATLAS_SEED_CORPUS=examples/corpus
